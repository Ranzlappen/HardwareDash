<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════ CAMERA & TORCH ══════════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera"        android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash"  android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ══════════════════════ AUDIO ══════════════════════════════ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ══════════════════════ VIBRATION ══════════════════════════ -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ══════════════════════ WIFI / NETWORK ═════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ══════════════════════ BLUETOOTH ══════════════════════════ -->
    <!-- Legacy for API 29-30 (Huawei P30) -->
    <uses-permission android:name="android.permission.BLUETOOTH"       android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Modern for API 31+ (Xiaomi 14T Pro) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"   android:usesPermissionFlags="neverForLocation" />

    <!-- ══════════════════════ NFC ═════════════════════════════════ -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- ══════════════════════ LOCATION (for WiFi scan) ════════════ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ══════════════════════ NOTIFICATIONS / SERVICES ════════════ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"     />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ══════════════════════ OVERLAY (lock-screen widget) ════════ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ══════════════════════ DEVICE ADMIN ════════════════════════ -->
    <!--  Allows locking the screen programmatically  -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- ══════════════════════ STEP COUNTER ══════════════════════ -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- ══════════════════════ TELEPHONY (signal info) ════════════ -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- ══════════════════════ LOGBOOK REMINDERS ═════════════════ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- ══════════════════════ BRIGHTNESS ═════════════════════════ -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ══════════════════════ SENSORS ════════════════════════════ -->
    <uses-feature android:name="android.hardware.sensor.gyroscope"     android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass"       android:required="false" />
    <uses-feature android:name="android.hardware.sensor.proximity"     android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light"         android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer"     android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter"  android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HardwareDash"
        android:hardwareAccelerated="true">

        <!-- ══════════════════════ APP METADATA ══════════════════════ -->
        <meta-data android:name="com.hardwaredash.AUTHOR"      android:value="Ranzlappen" />
        <meta-data android:name="com.hardwaredash.LICENSE"      android:value="Proprietary — All Rights Reserved" />
        <meta-data android:name="com.hardwaredash.DESCRIPTION"  android:value="Hardware Dashboard — monitor and control device sensors, camera, audio, and more" />
        <meta-data android:name="com.hardwaredash.REPOSITORY"   android:value="github.com/Ranzlappen/HardwareDash" />

        <!-- ── Main Activity ─────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- NFC tag dispatch -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- ── Caller Screen Activity (phone ring overlay) ────────── -->
        <activity
            android:name=".CallerScreenActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Device Admin Receiver (for screen lock) ───────────── -->
        <receiver
            android:name=".receivers.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

        <!-- ── Schedule Action Receiver ──────────────────────────────── -->
        <receiver
            android:name=".receivers.ScheduleActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hardwaredash.SCHEDULE_ACTION_FIRE" />
            </intent-filter>
        </receiver>

        <!-- ── Foreground Service ─────────────────────────────────── -->
        <service
            android:name=".services.HardwareService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- ── Strobe Service ──────────────────────────────────────── -->
        <service
            android:name=".services.StrobeService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- ── Home Screen Widget (Metric) ───────────────────────── -->
        <receiver
            android:name=".widget.HardwareDashWidgetProvider"
            android:label="@string/widget_label_metric"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- ── Log Now Widget ────────────────────────────────────── -->
        <receiver
            android:name=".widget.LogNowWidgetProvider"
            android:label="@string/widget_label_log_now"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_LOG_NOW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_log_now_info" />
        </receiver>

        <!-- ── Flashlight Widget ─────────────────────────────────── -->
        <receiver
            android:name=".widget.FlashlightWidgetProvider"
            android:label="@string/widget_label_flashlight"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_FLASHLIGHT_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_flashlight_info" />
        </receiver>

        <!-- ── Strobe Widget ─────────────────────────────────────── -->
        <receiver
            android:name=".widget.StrobeWidgetProvider"
            android:label="@string/widget_label_strobe"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_STROBE_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strobe_info" />
        </receiver>

        <!-- ── Camera Snapshot Widget ────────────────────────────── -->
        <receiver
            android:name=".widget.CameraSnapshotWidgetProvider"
            android:label="@string/widget_label_camera_snapshot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_CAMERA_SNAPSHOT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_camera_snapshot_info" />
        </receiver>

        <!-- ── Video Toggle Widget ───────────────────────────────── -->
        <receiver
            android:name=".widget.VideoToggleWidgetProvider"
            android:label="@string/widget_label_video_toggle"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_VIDEO_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_video_toggle_info" />
        </receiver>

        <!-- ── Video Record Service ──────────────────────────────── -->
        <service
            android:name=".services.VideoRecordService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- ── Voice Record Widget ───────────────────────────────── -->
        <receiver
            android:name=".widget.VoiceRecordWidgetProvider"
            android:label="@string/widget_label_voice_record"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_VOICE_RECORD_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_voice_record_info" />
        </receiver>

        <!-- ── Voice Record Service ──────────────────────────────── -->
        <service
            android:name=".services.VoiceRecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ── Phone Ring Widget ─────────────────────────────────── -->
        <receiver
            android:name=".widget.PhoneRingWidgetProvider"
            android:label="@string/widget_label_phone_ring"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_RING_30S" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_phone_ring_info" />
        </receiver>

        <!-- ── Notify in 30s Widget ──────────────────────────────── -->
        <receiver
            android:name=".widget.NotifyWidgetProvider"
            android:label="@string/widget_label_notify"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_NOTIFY_30S" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_notify_info" />
        </receiver>

        <!-- ── dB Meter Widget ───────────────────────────────────── -->
        <receiver
            android:name=".widget.DbMeterWidgetProvider"
            android:label="@string/widget_label_db_meter"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_DB_METER_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_db_meter_info" />
        </receiver>

        <!-- ── dB Meter Service ──────────────────────────────────── -->
        <service
            android:name=".services.DbMeterService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ── NFC HCE Emulation Service ─────────────────────────── -->
        <service
            android:name=".services.NfcEmulationService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/nfc_hce_aid" />
        </service>

        <!-- ── Vibration Toggle Widget ───────────────────────────── -->
        <receiver
            android:name=".widget.VibrationWidgetProvider"
            android:label="@string/widget_label_vibration"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hardwaredash.widget.ACTION_VIBRATION_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vibration_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>
</manifest>
