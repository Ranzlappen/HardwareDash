<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════ CAMERA & TORCH ══════════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera"        android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash"  android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ══════════════════════ AUDIO ══════════════════════════════ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ══════════════════════ VIBRATION ══════════════════════════ -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ══════════════════════ WIFI / NETWORK ═════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ══════════════════════ BLUETOOTH ══════════════════════════ -->
    <!-- Legacy for API 29-30 (Huawei P30) -->
    <uses-permission android:name="android.permission.BLUETOOTH"       android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Modern for API 31+ (Xiaomi 14T Pro) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"   android:usesPermissionFlags="neverForLocation" />

    <!-- ══════════════════════ NFC ═════════════════════════════════ -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- ══════════════════════ INFRARED (transmit-only) ═══════════ -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />

    <!-- ══════════════════════ USB HOST (Flipper Zero CDC-ACM) ════ -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- ══════════════════════ LOCATION (for WiFi scan + GPS spoofing) ════════════ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION + ACCESS_MOCK_LOCATION are declared by
         :feature:gps (they back the spoofing subsystem) and merge in from
         there. -->

    <!-- ══════════════════════ NOTIFICATIONS / SERVICES ════════════ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets HardwareDash appear in Settings → Notifications → Do Not Disturb
         access. Without this declaration the DND-access page opens a global
         app list that omits us, so the user can never grant the toggle. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"     />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- ══════════════════════ KEEP-ALIVE / DOZE ══════════════════ -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ══════════════════════ OVERLAY (lock-screen widget) ════════ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ══════════════════════ STEP COUNTER ══════════════════════ -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- ══════════════════════ TELEPHONY (signal info) ════════════ -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- ══════════════════════ AUTOMATION SCHEDULE TRIGGERS ══════ -->
    <!-- Opt-in exact alarms for :core:automation's Schedule trigger;
         degrades to inexact setWindow when the user hasn't granted it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- ══════════════════════ BRIGHTNESS ═════════════════════════ -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ══════════════════════ SENSORS ════════════════════════════ -->
    <uses-feature android:name="android.hardware.sensor.gyroscope"     android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass"       android:required="false" />
    <uses-feature android:name="android.hardware.sensor.proximity"     android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light"         android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer"     android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter"  android:required="false" />

    <!-- ══════════════════════ APP ORGANIZER ══════════════════════ -->
    <!-- Make every launcher-visible app and WebAPK PWA queryable via
         LauncherApps / PackageManager so the App-Organizer module can
         enumerate them. Play-Store-friendly; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Optional usage-stats access for the "Unused" smart-folder rule.
         The user must explicitly grant this in Settings → Apps →
         Special access → Usage access. The rule degrades to an empty
         folder if not granted, never crashes. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".GadgetApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gadget"
        android:hardwareAccelerated="true">

        <!-- ══════════════════════ APP METADATA ══════════════════════ -->
        <meta-data android:name="dev.ranzlappen.gadget.AUTHOR"      android:value="Ranzlappen" />
        <meta-data android:name="dev.ranzlappen.gadget.LICENSE"      android:value="Proprietary — All Rights Reserved" />
        <meta-data android:name="dev.ranzlappen.gadget.DESCRIPTION"  android:value="Gadget — monitor and control device sensors, camera, audio, and more" />
        <meta-data android:name="dev.ranzlappen.gadget.REPOSITORY"   android:value="github.com/Ranzlappen/HardwareDash" />

        <!-- ══════════════════════ WORKMANAGER ON-DEMAND INIT ══════════ -->
        <!-- GadgetApplication implements androidx.work.Configuration.Provider so we
             must opt out of the default startup initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ── Main Activity ─────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- USB device attached (Flipper Zero) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/flipper_usb_filter" />

            <!-- NFC tag dispatch -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- Legacy dead-code purge: the pre-modular CallerScreenActivity,
             AdminReceiver, ScheduleActionReceiver, and the eight legacy
             foreground services (Gadget / Vibration / Strobe / Link /
             VideoRecord / VoiceRecord / DbMeter / NfcEmulation) were
             deleted — none was reachable at runtime. Their modular
             replacements register in their own feature manifests
             (torch strobe FGS, radios-nfc HCE, audio record FGS, …) and
             merge in. -->

        <!-- The App-Organizer folder popup + folder widget now live in
             :feature:apps (modular migration); their manifest entries moved
             with them. -->

        <!-- ── Batch-7: Persistent keep-alive foreground service ─────── -->
        <service
            android:name=".services.PersistentKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- GPS spoofing playback foreground service now lives in
             :feature:gps (dev.ranzlappen.gadget.feature.gps.spoof) and is
             folded back in via manifest merge. -->

    </application>
</manifest>
