<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Torch widget configs key on appWidgetId (device-specific) and the
         pin-flow bridge is transient, so exclude both from cloud backup and
         device-to-device transfer — a restore can't map old widget IDs onto
         the new device's launcher. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/torch_widgets.preferences_pb" />
        <exclude domain="file" path="datastore/torch_pending_widgets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/torch_widgets.preferences_pb" />
        <exclude domain="file" path="datastore/torch_pending_widgets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>