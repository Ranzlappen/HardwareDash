<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 folder widget. Three render modes (FolderWidgetRenderer toggles
  visibility):

    1. Cover IMAGE (gallery photo) — widget_folder_cover_image is VISIBLE.
       Never tinted; rendered as-is via setImageViewBitmap.
    2. Cover SYMBOL (Material symbol) — widget_folder_cover_symbol is VISIBLE.
       Tinted to folder.baseColorArgb via setColorFilter. Distinct from the
       photo view so the SRC_IN tint of one mode never bleeds into the other.
    3. Default (no cover) — widget_folder_grid_section VISIBLE: folder name
       strip on top, 2x2 LinearLayout grid of preview tiles below. Empty tile
       slots set INVISIBLE so the 2x2 alignment stays stable.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_folder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_folder_cover_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_folder_label"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_folder_cover_symbol"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_folder_label"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_folder_grid_section"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Folder"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_folder_tile_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_folder_tile_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_folder_tile_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_folder_tile_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
