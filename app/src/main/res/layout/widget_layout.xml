<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <!-- Refresh button (top-right) -->
    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:contentDescription="Refresh"
        android:src="@drawable/widget_refresh_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="2dp" />

    <!-- Metric name (auto-scaling) -->
    <TextView
        android:id="@+id/widget_metric_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/widget_refresh"
        android:layout_marginEnd="4dp"
        android:text="Metric"
        android:textColor="#B0BEC5"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Metric value (auto-scaling, large) -->
    <TextView
        android:id="@+id/widget_metric_value"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_metric_name"
        android:layout_alignParentStart="true"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:text="--"
        android:textColor="#E0E0E0"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeStepGranularity="1sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end" />

</RelativeLayout>
