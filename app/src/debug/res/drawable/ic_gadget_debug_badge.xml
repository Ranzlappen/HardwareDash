<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build subscript badge.

    Renders "<>" in the bottom-right corner — a code/dev-style
    glyph indicating the build is a debug artefact, replacing the
    earlier bug-icon design.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="1.2"
        android:translateY="1.4">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#00000080"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M80,76 L75,82 L80,88" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#00000080"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M88,76 L93,82 L88,88" />
    </group>
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M80,76 L75,82 L80,88" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M88,76 L93,82 L88,88" />
</vector>
