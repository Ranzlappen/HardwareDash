<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      User-grantable special permission for the per-rule `exact` schedule
      opt-in (denied by default on Android 14+ fresh installs; the scheduler
      degrades to a windowed alarm per AlarmSchedulingDecision).
      USE_EXACT_ALARM is deliberately NOT used — Play restricts it to
      alarm-clock/calendar apps (ADR-0002 Decision 4).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application>
        <!--
          The automation engine runs as ONE specialUse foreground service for
          the whole app (a single cross-cutting engine, not one service per
          module — same spirit as :core:monitoring's MonitorService). It is
          resident ONLY while >=1 enabled rule has a metric-stream
          (MetricThreshold) trigger; schedule / broadcast / manual rules run
          one-shot with no resident service. No standard foregroundServiceType
          fits "continuous user-defined rule evaluation", so specialUse is
          declared with a Play-console justification property.
        -->
        <service
            android:name=".service.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Event-driven evaluation of user-defined automation rules (metric-threshold triggers) to dispatch on-device actions." />
        </service>

        <!-- One-shot landing point for AutomationScheduler's alarms. -->
        <receiver
            android:name=".service.AutomationAlarmReceiver"
            android:exported="false" />

        <!--
          Power events are on the implicit-broadcast exemption list, so a
          manifest receiver still gets them. Connectivity is NOT armed here
          (not deliverable to manifest receivers since Android N — see the
          receiver KDoc + design doc).
        -->
        <receiver
            android:name=".service.AutomationSystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
