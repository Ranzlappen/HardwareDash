<?xml version="1.0" encoding="utf-8"?>
<!--
  Kit-owned strings for the WidgetAppearanceSection (the chip-row +
  icon-picker + tap-animation + feedback-template UI a widget-bearing
  feature drops into its configuration sheet via WidgetAppearanceSection).

  Lifted from torch's strings.xml in refactor-2026 Phase 2 / C6b so every
  widget-bearing feature shares one localised copy. Torch-specific strings
  (sheet title / save / cancel / morse / preview hint) stay in
  feature/torch/.../strings.xml.

  Naming: widget_kit_appearance_* prefix so a feature consuming the kit
  can grep its own res for "widget_kit_*" and instantly see what it's
  reusing.
-->
