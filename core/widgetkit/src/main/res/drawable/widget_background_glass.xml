<?xml version="1.0" encoding="utf-8"?>
<!--
  Default glassmorphic background for torch widgets — mirrors the
  in-app DashCard aesthetic. A rounded-rect shape with a translucent
  fill + 1 dp outline tinted with the theme's outline colour.

  Used by WidgetAppearanceRenderer when WidgetAppearance.background
  == BackgroundMode.GlassSurface (the default).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#33222222" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
