<?xml version="1.0" encoding="utf-8"?>
<!--
  Device-admin policy for GadgetDeviceAdminReceiver. Requests ONLY force-lock
  (the single policy DevicePolicyManager.lockNow needs). No wipe-data, no
  password-quality, no other enforcement — the app locks the screen on demand
  and nothing more.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
