<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Best-effort favicon fetch for user-added web-link "apps"
         (FaviconFetcher). Direct <host>/favicon.ico|png only — never a
         third-party indexing service. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Floating folder popup launched from the folder home-screen widget
             (and via PendingIntent). Not exported: only this app starts it. -->
        <activity
            android:name=".ui.folder.FolderPopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.GadgetApps.FolderPopup" />
    </application>

</manifest>
