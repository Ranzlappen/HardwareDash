<?xml version="1.0" encoding="utf-8"?>
<!--
  Single adaptive folder-widget layout (replaces the legacy widget_folder_2x2
  + widget_folder_1x1 pair). FolderWidgetProvider toggles visibility for three
  render modes and gates the name strip on the resolved render density:

    1. Cover IMAGE   — widget_folder_cover_image VISIBLE (never tinted).
    2. Cover SYMBOL  — widget_folder_cover_symbol VISIBLE (tinted to the
                       folder's base color via setColorFilter).
    3. Default       — widget_folder_grid_section VISIBLE: an (optional) name
                       strip + a 2x2 preview-tile grid; empty slots INVISIBLE.

  RemoteViews-safe: only @RemoteView-inflatable classes (RelativeLayout /
  LinearLayout / ImageView / TextView). No bare <View> (the launcher throws
  InflateException on those — see CLAUDE.md).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_folder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Kit appearance chrome (glass / solid / transparent), painted by
         WidgetAppearanceRenderer.applyBackground via the kit-declared
         @id/widget_background. Backmost child so the cover / grid overlay it. -->
    <ImageView
        android:id="@id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/widget_folder_cover_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/apps_widget_folder_label"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_folder_cover_symbol"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/apps_widget_folder_label"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_folder_grid_section"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/apps_widget_folder_label"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_folder_tile_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_folder_tile_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_folder_tile_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_folder_tile_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
