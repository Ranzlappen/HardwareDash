<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Floating, transparent theme for FolderPopupActivity — the modular twin
         of the legacy Theme.Gadget.Translucent. The system finishes the
         activity automatically when the user taps outside the floating window
         (windowCloseOnTouchOutside=true). -->
    <style name="Theme.GadgetApps.FolderPopup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
