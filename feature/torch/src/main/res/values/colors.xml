<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Widget icon tints — RemoteViews can't read the active
      MaterialTheme colour scheme (it lives in the launcher process),
      so we approximate the theme's accent + on-surface colours as
      static colour resources. Matches the dark-first default theme;
      a future "light widget" variant could swap these via
      values-night/.
    -->
    <color name="widget_tint_accent">#FFB0BFFF</color>
    <color name="widget_tint_on_surface">#FFE6E1E5</color>

    <!--
      Monitor-chart widget colors. The Compose chart pulls accent /
      surface from the live theme; the RemoteViews-backed widget can't,
      so we approximate teal (line) + 20% teal (area fill). A future
      values-night/ split could match a light-widget variant.
    -->
    <color name="widget_chart_line">#FF26C6DA</color>
    <color name="widget_chart_fill">#3326C6DA</color>
</resources>
