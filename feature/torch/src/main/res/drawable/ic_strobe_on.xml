<?xml version="1.0" encoding="utf-8"?>
<!--
  Active-strobe glyph: the same lightning bolt as ic_strobe.xml plus
  a pair of "emission" radial rays signalling that the strobe loop is
  currently running. Used by StrobeWidgetProvider's onUpdate when
  StrobeService.isRunning == true; the inactive state continues to
  use ic_strobe.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Bolt body (same as ic_strobe.xml for visual continuity). -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M14,2L7,12L11,12L9,22L17,10L13,10L14,2z" />
    <!-- Radial emission rays — left + right + top. Each is a short
         rounded-rectangle, painted in the same fill so the silhouette
         reads as one mark at small sizes. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.0,11.0L4.5,11.0L4.5,13.0L2.0,13.0L2.0,11.0z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19.5,11.0L22.0,11.0L22.0,13.0L19.5,13.0L19.5,11.0z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11.0,0.5L13.0,0.5L13.0,2.0L11.0,2.0L11.0,0.5z" />
</vector>
