<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid-fill background; the runtime tint is applied by
  WidgetAppearanceRenderer via setBackgroundColor on the host view.
  The drawable itself is a neutral-grey rounded rect — the
  RemoteViews colour override paints over the solid fill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#FF1F1F1F" />
</shape>
