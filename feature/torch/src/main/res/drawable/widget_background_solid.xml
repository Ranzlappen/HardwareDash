<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid-fill background shape. Set as the @id/widget_background
  ImageView's image; WidgetAppearanceRenderer recolours it to the
  per-widget WidgetAppearance.solidColor via setColorFilter
  (PorterDuff.SRC_ATOP), which repaints the opaque rounded rect while
  preserving its corners. The base colour here is just a fallback for
  any path that renders the shape untinted.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#FF1F1F1F" />
</shape>
