<?xml version="1.0" encoding="utf-8"?>
<!--
  :feature:torch — surfaces for the flashlight feature.

  Permissions, hardware features, the TileService, two AppWidget
  receivers, the dynamic-widget pin-success receiver, and the
  StrobeService foreground service are all co-located here. The app's
  manifest merger picks them into the final manifest automatically (no
  app-level wiring needed).

  Standard-flavor surface only. Rooted-flavor torch extras will ship
  as a sibling :feature:torch-rooted Gradle module per the codebase's
  convention for feature-level rooted surfaces (see issue #94 +
  CLAUDE.md flavor rules).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      FOREGROUND_SERVICE for the StrobeService notification chrome on
      API 28+. The strobe runs as a `shortService`-typed foreground
      service on API 34+, which does not require the CAMERA runtime
      permission (CameraManager.setTorchMode itself never has). The OS
      enforces a 3-minute cap on shortService — accepted as a safety
      feature (a strobe left running indefinitely would burn battery
      and pose a hazard).

      `FOREGROUND_SERVICE_CAMERA` was removed alongside the FGS type
      switch — the camera-typed FGS requires CAMERA + CAMERA_FGS, and
      the user has to grant the runtime permission. shortService side-
      steps both for the strobe use case.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <!--
      POST_NOTIFICATIONS required on API 33+ for the StrobeService's
      foreground-service notification. Runtime-prompted; the user
      can deny without breaking the strobe (the service still runs;
      they just don't see the notification chrome).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Flash unit is the actual hardware dependency. `required="false"`
      so the app installs on flashless devices; the controller emits
      `isAvailable = false` and the UI disables the toggle.
    -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>

        <!--
          Quick Settings tile.

          BIND_QUICK_SETTINGS_TILE is required so only the OS's
          QS-tile-binding can launch the service. exported=true is
          required for the OS to find the tile during edit-tiles.
        -->
        <service
            android:name=".tile.FlashlightTileService"
            android:exported="true"
            android:icon="@drawable/ic_flashlight_on"
            android:label="@string/torch_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Home-screen flashlight widget. exported=true required for
          AppWidget host (Launcher) to receive the broadcasts.
        -->
        <receiver
            android:name=".widget.FlashlightWidgetProvider"
            android:exported="true"
            android:label="@string/widget_flashlight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.ranzlappen.gadget.feature.torch.ACTION_FLASHLIGHT_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_flashlight_info" />
        </receiver>

        <!--
          Home-screen strobe widget — toggles StrobeService.
        -->
        <receiver
            android:name=".widget.StrobeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_strobe_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.ranzlappen.gadget.feature.torch.ACTION_STROBE_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strobe_info" />
        </receiver>

        <!--
          Home-screen monitor widget — torch's "show as widget" reference
          for the reusable monitoring framework. Renders the latest
          torch_intensity sample as a determinate ProgressBar with a
          toggle + reload. Added from the launcher's widget picker; live
          updates pushed by MonitorService via TorchMonitorWidgetNotifier.
        -->
        <receiver
            android:name=".widget.MonitorWidgetProvider"
            android:exported="true"
            android:label="@string/widget_monitor_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.ranzlappen.gadget.feature.torch.ACTION_MONITOR_TOGGLE" />
                <action android:name="dev.ranzlappen.gadget.feature.torch.ACTION_MONITOR_RELOAD" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monitor_info" />
        </receiver>

        <!--
          Pin-success callback receiver for AppWidgetManager.requestPinAppWidget.
          exported=true because the OS dispatches the success
          PendingIntent from the system process. The custom action
          string is private to our package (PendingIntent's
          ComponentName resolves to us), so the public surface is
          minimal.
        -->
        <receiver
            android:name=".widget.WidgetPinSuccessReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.ranzlappen.gadget.feature.torch.ACTION_WIDGET_PIN_SUCCESS" />
            </intent-filter>
        </receiver>

        <!--
          Strobe foreground service. exported=false — only the widget
          provider + the in-app screen can start it.

          foregroundServiceType="shortService" (API 34+) lets the OS
          allow a user-initiated FGS without requiring any camera-
          family permission. setTorchMode doesn't need CAMERA on AOSP,
          and shortService caps the service at 3 minutes — the
          natural "max strobe session" safety limit. Devices on API
          29-33 ignore the attribute and fall back to a legacy
          untyped foreground service.
        -->
        <service
            android:name=".strobe.StrobeService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

    </application>
</manifest>
