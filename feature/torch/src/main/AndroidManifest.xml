<?xml version="1.0" encoding="utf-8"?>
<!--
  :feature:torch — surfaces for the flashlight feature.

  Permissions, hardware features, the TileService, two AppWidget
  receivers, and the StrobeService foreground service are all
  co-located here. The app's manifest merger picks them into the
  final manifest automatically (no app-level wiring needed).

  Standard-flavor only — the rooted torch extras live in a future
  rooted-flavor module per the migration plan in docs/migration-guide.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      CAMERA — required by CameraManager.setTorchMode (Camera2 API).
      The OS grants the torch capability when the device has a flash
      unit; no runtime prompt for torch-only Camera2 calls on most
      OEMs but apps still declare the permission so the merger picks
      it up.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      FOREGROUND_SERVICE + the camera-typed variant for StrobeService
      so the OS allows the foreground notification + camera-flash
      access on API 34+.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!--
      POST_NOTIFICATIONS required on API 33+ for the StrobeService's
      foreground-service notification. Runtime-prompted; the user
      can deny without breaking the strobe (the service still runs;
      they just don't see the notification chrome).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Flash unit is the actual hardware dependency. `required="false"`
      so the app installs on flashless devices; the controller emits
      `isAvailable = false` and the UI disables the toggle.
    -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>

        <!--
          Quick Settings tile.

          BIND_QUICK_SETTINGS_TILE is required so only the OS's
          QS-tile-binding can launch the service. exported=true is
          required for the OS to find the tile during edit-tiles.
        -->
        <service
            android:name=".tile.FlashlightTileService"
            android:exported="true"
            android:icon="@drawable/ic_flashlight_on"
            android:label="@string/torch_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Home-screen flashlight widget. exported=true required for
          AppWidget host (Launcher) to receive the broadcasts.
        -->
        <receiver
            android:name=".widget.FlashlightWidgetProvider"
            android:exported="true"
            android:label="@string/widget_flashlight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.ranzlappen.gadget.feature.torch.ACTION_FLASHLIGHT_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_flashlight_info" />
        </receiver>

        <!--
          Home-screen strobe widget — toggles StrobeService.
        -->
        <receiver
            android:name=".widget.StrobeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_strobe_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.ranzlappen.gadget.feature.torch.ACTION_STROBE_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strobe_info" />
        </receiver>

        <!--
          Strobe foreground service. exported=false — only the widget
          provider + the in-app screen can start it.
          foregroundServiceType="camera" so the OS allows access to
          the flash unit while in foreground state.
        -->
        <service
            android:name=".strobe.StrobeService"
            android:exported="false"
            android:foregroundServiceType="camera" />

    </application>
</manifest>
