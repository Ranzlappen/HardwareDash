<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keep-alive lifeline: a dataSync foreground service that survives Doze. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- Persistent keep-alive foreground service (both flavors; the
             KeepAliveController that starts it is flavor-bound). Migrated from
             the legacy :app com.gadget.services.PersistentKeepAliveService. -->
        <service
            android:name=".service.PersistentKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
