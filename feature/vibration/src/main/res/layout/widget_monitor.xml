<?xml version="1.0" encoding="utf-8"?>
<!--
  Monitor widget layout — RemoteViews-safe classes only (LinearLayout,
  TextView, ProgressBar, Button, ImageButton). See the RemoteViews note
  in CLAUDE.md: a bare <View>/<Space> would throw InflateException.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_glass"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_monitor_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_monitor_label"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/widget_monitor_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_monitor_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_monitor_toggle_off" />

        <ImageButton
            android:id="@+id/widget_monitor_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_monitor_reload"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>
</LinearLayout>
