<?xml version="1.0" encoding="utf-8"?>
<!--
  Vibrate widget layout. Backing surface (@id/widget_background) +
  icon (@id/widget_icon) on top, with a clickable ImageButton
  (@id/widget_vibrate_button) the provider attaches a PendingIntent to.
  @id/widget_background + @id/widget_icon are the WidgetAppearanceRenderer
  contract surface (declared in :core:widgetkit ids.xml). RemoteViews-safe
  views only.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <ImageButton
        android:id="@+id/widget_vibrate_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_vibrate_label"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@android:color/transparent" />

    <ImageView
        android:id="@id/widget_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_vibration_on" />

    <!-- Adaptive name label — the provider toggles its visibility per
         WidgetRenderDensity (shown only at the Expanded density). The id comes
         from :core:widgetkit's values/ids.xml; RemoteViews-safe TextView. -->
    <TextView
        android:id="@id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="@android:color/white"
        android:visibility="gone" />

</FrameLayout>
